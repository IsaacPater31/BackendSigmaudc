# ============================================================
# SIGMA-UDC — Backend: Variables de entorno
# Copiar este archivo como ".env" y completar los valores.
# NUNCA subir el archivo .env al repositorio.
# ============================================================

# Cadena de conexión a PostgreSQL (obligatoria)
# Formato: postgres://usuario:contrasena@host:puerto/base?sslmode=disable
DATABASE_URL=postgres://usuario:contrasena@localhost:5432/sigmaudc?sslmode=disable

# Clave secreta para firmar tokens JWT (obligatoria)
# Generar una cadena aleatoria segura, mínimo 32 bytes.
JWT_SECRET=cambiar-por-una-clave-segura

# Puerto en el que escucha el servidor HTTP (opcional, por defecto 8080)
PORT=8080

# Origen permitido para CORS (opcional, por defecto "*")
# En producción debe ser el dominio exacto del frontend.
CORS_ORIGIN=http://localhost:5173

# Directorio donde se almacenan los archivos subidos (opcional, por defecto ./uploads)
UPLOAD_DIR=./uploads
